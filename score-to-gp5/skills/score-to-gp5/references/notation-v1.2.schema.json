{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guitar notation 1.2 - electric guitar effects",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "sources",
    "measures",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": "guitar-notation/1.2"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "bpm",
        "tempo_status",
        "capo_fret",
        "tuning_midi_6_to_1",
        "meter",
        "let_ring"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "artist": {
          "type": "string"
        },
        "bpm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "tempo_status": {
          "enum": [
            "printed",
            "user",
            "estimated"
          ]
        },
        "capo_fret": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "tuning_midi_6_to_1": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          }
        },
        "meter": {
          "$ref": "#/$defs/meter"
        },
        "let_ring": {
          "type": "boolean"
        },
        "midi_program": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "events"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "meter": {
            "$ref": "#/$defs/meter"
          },
          "length_beats": {
            "$ref": "#/$defs/rational"
          },
          "source_id": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/$defs/event"
            }
          },
          "source_measure": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "enum": [
              "unresolved",
              "assumption"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "measure": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "rational": {
      "type": "string",
      "pattern": "^[0-9]+(/[1-9][0-9]*)?$"
    },
    "meter": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        {
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32,
            64
          ]
        }
      ],
      "items": false
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "string",
        "fret"
      ],
      "properties": {
        "string": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "fret": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "tie": {
          "type": "boolean"
        },
        "velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "technique_from_previous": {
          "enum": [
            "hammer_on",
            "pull_off",
            "shift_slide",
            "legato_slide"
          ]
        },
        "dead": {
          "type": "boolean"
        },
        "palm_mute": {
          "type": "boolean"
        },
        "accent": {
          "type": "boolean"
        },
        "harmonic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "natural",
                "artificial",
                "tapped"
              ]
            },
            "touch_fret": {
              "type": "integer",
              "minimum": 1,
              "maximum": 48
            }
          }
        },
        "vibrato": {
          "type": "boolean"
        },
        "staccato": {
          "type": "boolean"
        },
        "let_ring": {
          "type": "boolean"
        },
        "bend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "points"
          ],
          "properties": {
            "type": {
              "enum": [
                "bend",
                "bendRelease",
                "bendReleaseBend",
                "prebend",
                "prebendRelease"
              ]
            },
            "points": {
              "type": "array",
              "minItems": 2,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "position",
                  "semitones"
                ],
                "properties": {
                  "position": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12
                  },
                  "semitones": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12
                  }
                }
              }
            }
          }
        },
        "grace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fret",
            "transition",
            "duration"
          ],
          "properties": {
            "fret": {
              "type": "integer",
              "minimum": 0,
              "maximum": 36
            },
            "transition": {
              "enum": [
                "none",
                "slide",
                "hammer",
                "bend"
              ]
            },
            "duration": {
              "enum": [
                16,
                32,
                64
              ]
            },
            "on_beat": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beat",
        "duration",
        "notes"
      ],
      "properties": {
        "beat": {
          "$ref": "#/$defs/rational"
        },
        "duration": {
          "$ref": "#/$defs/rational"
        },
        "notes": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/note"
          }
        },
        "rest": {
          "type": "boolean"
        },
        "arpeggio": {
          "enum": [
            "low_to_high",
            "high_to_low"
          ]
        },
        "arpeggio_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "text": {
          "type": "string"
        },
        "capo_change": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "attack": {
          "enum": [
            "tapping",
            "slapping",
            "popping"
          ]
        },
        "percussion": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "sound"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "string_slap",
                  "body_hit"
                ]
              },
              "sound": {
                "enum": [
                  "side_stick",
                  "low_wood_block",
                  "acoustic_bass_drum"
                ]
              },
              "velocity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 127
              }
            }
          }
        },
        "pick_stroke": {
          "enum": [
            "up",
            "down"
          ]
        }
      }
    }
  }
}
